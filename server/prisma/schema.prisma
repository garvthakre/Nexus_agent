generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  passwordHash String
  createdAt   DateTime     @default(now())
  apiKeys     UserApiKey[]
  sessions    Session[]
  traces      Trace[]
  webhooks    UserWebhook[]
}

model UserApiKey {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  encryptedKey   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model Session {
  id           String     @id @default(uuid())
  userId       String
  plan         Json
  status       String
  currentStep  Int        @default(0)
  stopped      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepLogs     StepLog[]

  @@index([userId, createdAt])
}

model StepLog {
  id          String   @id @default(uuid())
  sessionId   String
  stepNumber  Int
  status      String
  result      Json?
  error       String?
  durationMs  Int?
  createdAt   DateTime @default(now())
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, stepNumber])
}

model Trace {
  id                  String      @id @default(uuid())
  userId              String
  sessionId           String?
  prompt              String
  summary             String?
  status              String
  provider            String?
  totalSteps          Int         @default(0)
  successfulSteps     Int         @default(0)
  failedSteps         Int         @default(0)
  totalTokens         Int         @default(0)
  llmLatencyMs        Int         @default(0)
  executionLatencyMs  Int         @default(0)
  metadata            Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  traceSteps          TraceStep[]

  @@index([userId, createdAt])
}

model TraceStep {
  id                  String   @id @default(uuid())
  traceId             String
  stepNumber          Int
  capability          String
  description         String
  status              String
  error               String?
  result              Json?
  screenshotPath      String?
  llmLatencyMs        Int?
  executionLatencyMs  Int?
  tokenUsage          Int?
  startedAt           DateTime @default(now())
  completedAt         DateTime?
  trace               Trace    @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([traceId, stepNumber])
}

model UserWebhook {
  id          String   @id @default(uuid())
  userId      String
  name        String?
  url         String
  events      Json
  active      Boolean  @default(true)
  headers     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}
